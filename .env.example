# ==============================================================================
# Environment Configuration - Project Management System (Monorepo)
# ==============================================================================
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR .env FILES TO GIT VERSION CONTROL.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=<schema>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pms_dev?schema=public"

# Database Container Configuration (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pms_dev
POSTGRES_PORT=5432

# Authentication & Security
# WARNING: Generate strong random secrets for production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET="change-this-to-a-secure-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Web Client Configuration
WEB_ORIGIN="http://localhost:5173"

# Mobile & API URLs
API_URL="http://localhost:3000"
