    "@pms/validation": "workspace:*",
    "expo": "~52.0.0",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
